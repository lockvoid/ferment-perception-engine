# Rust
/target/
**/target/
crates/engine-media/fuzz/artifacts/

# Vendored ONNX Runtime and FFmpeg native libs. Too large for git (>10 MB);
# `just provision-ort-mac` / `just provision-ort-win` /
# `just provision-ffmpeg-mac` fetch them into these paths.
vendor/onnxruntime/
vendor/ffmpeg/
# scripts/provision-ffmpeg's source cache: the pinned FFmpeg tarball and
# its extracted tree, ~1 GB once a build has run through it.
tmp/
# scripts/models-publish's staging tree and its .mlmodelc cache.
dist/
# The Nemotron export's ONNX masters and their external weight files: ~2.4 GB
# across ~300 files, regenerated by `scripts/exports/nemotron/export.py` from
# the checkpoint. The two SIDECARS are small and are committed.
scripts/exports/nemotron/artifacts/*
!scripts/exports/nemotron/artifacts/nemotron_metadata.json
!scripts/exports/nemotron/artifacts/nemotron_vocab.json
# The EdgeTAM masters, 38 MB for the two image-path graphs; regenerated by
# scripts/exports/edgetam/export.py from the upstream checkpoint.
scripts/exports/edgetam/artifacts/*.onnx

# OS / editors
.DS_Store
*.swp

# Exported model graphs and local results from external reference clips.
# The model fleet and its reference data are supplied separately.
scripts/exports/**/*.onnx
scripts/exports/rife/natural/
scripts/exports/rust_goldens/rife_nat_*.bin
crates/engine-media/tests/fixtures/generated/conformance-hevc-*.mp4
scripts/exports/rife/extracted/
scripts/exports/rife/rife_v4.25.7z

# Semantic-audio exports: NeMo's triton-repo dump (external-data shards) and
# any master over ~10 MB stay out of git — the export scripts regenerate them
# and the CDN serves them. Synthetic reference values may live in the repository.
scripts/exports/parakeet/repo/
scripts/exports/parakeet/artifacts/parakeet_encoder.onnx
scripts/exports/parakeet/artifacts/parakeet_decoder.onnx
scripts/exports/parakeet/artifacts/parakeet_joint.onnx
scripts/exports/dasheng/artifacts/

# Speech-system exports (Track D): the two Conformer-scale masters and the
# AmberNet graph are over the 10 MB rule and are regenerated by
# scripts/exports/{gigaam,ambernet}/export_*.py or fetched from the Studio CDN.
# The fp32 encoder is the local golden reference only — the fp16 rung ships.
scripts/exports/gigaam/checkpoints/
scripts/exports/gigaam/artifacts/gigaam_encoder.onnx
scripts/exports/gigaam/artifacts/gigaam_encoder.fp16.onnx
scripts/exports/ambernet/checkpoints/
scripts/exports/ambernet/artifacts/ambernet_langid.onnx

# Track C visual encoder: the pinned facebookresearch/dinov2 clone (torch.hub
# through the GitHub API rate-limits, so export_dinov2.py loads it from disk)
# and both ONNX masters, which are over the 10 MB rule. export_dinov2.py
# regenerates them byte-for-byte and the Studio CDN serves the fp32 one; the
# resampler goldens and the rust_goldens tensors ship in-repo.
scripts/exports/dinov2/repo/
scripts/exports/dinov2/artifacts/dinov2_vits14.onnx
scripts/exports/dinov2/artifacts/dinov2_vits14.fp16.onnx

# Python environments and generated bytecode.
__pycache__/
*.pyc
.venv/

# Local compiler crash reports.
rustc-ice-*.txt

# Claude Code harness state (local worktrees for agent isolation).
/.claude/worktrees/

# Local configuration and credentials
.env
.env.*
!.env.example
.aws/
.ssh/
.huggingface/token
.cache/huggingface/token
.netrc
.pypirc
*.p12
*.pfx
*.p8
*.key
*.pem
.cargo/credentials
.cargo/credentials.toml
